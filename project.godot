; Engine configuration file.
; Pixel-perfect portrait setup for Dust In Space. See AGENTS.md before changing display settings.

config_version=5

[application]

config/name="Dust In Space"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

environment/defaults/default_clear_color=Color(0.027451, 0.035294, 0.121569, 1)
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
