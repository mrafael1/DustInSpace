# --- Godot 4 ---
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
# Mono / C# (only if C# is ever added)
.mono/
data_*/
mono_crash.*.json

# --- Builds & exports ---
build/
exports/
*.apk
*.aab
*.ipa
*.pck
*.exe
*.x86_64
*.dmg
*.zip

# --- Android / iOS signing (never commit) ---
*.keystore
*.jks
*.p12
*.mobileprovision
android/build/

# --- Aseprite / art scratch ---
# Source .aseprite files ARE committed (assets/art/source). Only temp files are ignored.
*.aseprite~
*.ase~
assets/art/_scratch/

# --- Python tools ---
__pycache__/
*.pyc
.venv/
venv/
tools/**/out/

# --- Editors & OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Agents ---
.claude/settings.local.json
.claude/worktrees/
